#: orders/models.py
msgid "Cash on Delivery"
msgstr "कैश ऑन डिलीवरी"

#: orders/models.py
msgid "UPI"
msgstr "UPI"

#: orders/models.py
msgid "Card"
msgstr "कार्ड"

#: orders/models.py
msgid "An offer must be at least ₹1."
msgstr "ऑफ़र कम से कम ₹1 का होना चाहिए।"

#: orders/views.py
msgid "Payment successful! Your order has been placed."
msgstr "भुगतान सफल रहा! आपका ऑर्डर हो गया है।"

